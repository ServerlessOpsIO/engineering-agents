{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SQS event carrying queued Slack messages",
  "type": "object",
  "required": [
    "Records"
  ],
  "properties": {
    "Records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "messageId",
          "body",
          "attributes"
        ],
        "properties": {
          "messageId": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "attributes": {
            "type": "object",
            "required": [
              "MessageGroupId"
            ]
          }
        }
      }
    }
  }
}
